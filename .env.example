# Demo mode requires no API credentials.
APP_MODE=demo
LOG_LEVEL=INFO

# Required only for live Gemini summaries.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required for APP_MODE=live read-only dashboard access.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional. Trusted backend writes only; never expose this key to browser code.
SUPABASE_SERVICE_ROLE_KEY=
